# Copy to .env.local with: npm run setup
# Required for login. Obtain both values from the SAME Supabase project.
# This file intentionally contains names only; do not commit real values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional server aliases for /api/image.
# Leave blank to use the VITE_ values above; never mix different projects.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Reference names ONLY: these are NOT read from .env by this application.
# Each member enters their own credentials in the app's Settings screen:
# GEMINI_API_KEY
# APIFY_API_TOKEN
#
# Configure these in Supabase Authentication > Email > SMTP, NOT in Vite:
# SMTP_HOST
# SMTP_PORT
# SMTP_USER
# SMTP_PASSWORD
# SMTP_SENDER_EMAIL
# SMTP_SENDER_NAME
#
# No service_role, Supabase secret key, database password, Vercel token,
# GitHub token, Google password or Gmail app password is required in app code.
# Never put a secret in a variable starting with VITE_: it is browser-visible.
